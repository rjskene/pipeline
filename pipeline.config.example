# pipeline.config.example — Copy to pipeline.config in your project root and edit.
#
# This file is sourced by shell scripts at runtime.

# Export every var assigned below so sourced values propagate to child bash
# steps (the auto-merge gate, helper scripts) that run in a separate subshell
# from the step that sourced this config — without per-caller `export`
# discipline (issue #801). NOTE: the gitignored, host-only live
# pipeline.config needs the SAME `set -a` / `set +a` wrapper applied by hand.
set -a

PIPELINE_REPO="owner/repo"                         # GitHub owner/repo
PIPELINE_BASE_BRANCH="staging"                     # PR target branch (default: staging — dev trunk; override per-repo if needed)
PIPELINE_WORKTREE_PREFIX="wt"                      # Worktree dir prefix (wt-<issue>-<slug>)
PIPELINE_INSTALL_CMD="npm ci"                      # Dependency install command (run from project root)
PIPELINE_SEED_CMD=""                               # DB seed command (optional, leave empty to skip)
# PIPELINE_TEST_CMD: the executor runs this as a SINGLE sequential verification pass
# (see execute-issue-plan Step 6b). Keep it scoped to the targeted/relevant tests.
# If you must script a loop, wrap it with a `timeout` and redirect `</dev/null` so an
# interactive `read` or a hang can't wedge the executor — and never an unbounded
# `for t in tests/test*.sh; do ...; done` sweep over unrelated tests (issue #677).
#
# Parallel form (issue #897): for a bash test tree, prefer the bundled parallel
# runner over a serial for-loop — it fans tests/test*.sh across cores with
# `xargs -P` and preserves STRICT aggregate fail via a sentinel file (a single
# failing test, even with a high exit code, still reds the run). It already
# wraps each test in `timeout 300 ... </dev/null`, so no extra hang-guard needed:
#   PIPELINE_TEST_CMD='bash scripts/run-test-suite.sh'
# Optionally cap the runner's fan-out width (defaults to `nproc`):
# PIPELINE_TEST_PARALLELISM=4
# NOTE: the live, host-only pipeline.config is GITIGNORED and cannot ship in a PR
# (see CLAUDE.md "Configuration conventions"). Apply the same parallel-runner edit
# to your live pipeline.config by HAND on the operator host — this example file is
# the only tracked surface a PR can land on.
PIPELINE_TEST_CMD="npm test"                       # Test command
PIPELINE_TYPECHECK_CMD="npx tsc --noEmit"          # Type check command
PIPELINE_CONTEXT_FILES="CLAUDE.md"                 # Space-separated list of CLAUDE.md files to read
PIPELINE_SYNC_ENVS=""                              # Space-separated .env files to sync to worktrees
PIPELINE_SYNC_VENVS=""                             # Space-separated venv dirs to symlink to worktrees
PIPELINE_SYNC_DOCS="CLAUDE.md"                     # Space-separated doc files to sync across worktrees
PIPELINE_SYNC_FILES=".mcp.json"                    # Space-separated other files to sync (e.g., .mcp.json)
PIPELINE_LABELS_EXCLUDED="excluded"                # Label to exclude issues from pipeline
PIPELINE_LABELS_LATER="later"                      # Label for deferred issues
PIPELINE_LABELS_HUMAN="human"                      # Label for issues that need a human in the loop (skipped by autonomous full send)
PIPELINE_LABELS_BRAINSTORM="brainstorm"             # Label for non-actionable discussion/exploration issues (visible in status table, never auto-planned)
PIPELINE_WIN_TEMP=""                               # Windows temp dir (e.g., /c/Users/you/AppData/Local/Temp). Leave empty for non-Windows.
PIPELINE_TMUX_SESSION="dev"                        # tmux session name for the queue runner + per-issue windows (default 'dev'; set per project to avoid collisions)
PIPELINE_CI_CHECK_ENABLED="true"                   # Gate the evaluate-issue-pr CI status check step. "true" keeps it; any other value (incl. "") strips the block from the rendered SKILL.md. Default ON when unset/absent (the fullsend 6b gate reads the colon-less ${VAR-true} fallback). Projects with no CI or with non-blocking CI should set this to "" to disable. When ON, a fully-green statusCheckRollup also short-circuits the evaluator's full-suite re-run (it trusts the green CI verdict and skips re-running PIPELINE_TEST_CMD locally — issue #957); when OFF/disabled, tests always run locally.
#PIPELINE_RELEASE_PR_AUTO_MERGE="false"            # Opt-in: auto-merge green release-bot PRs during /pipeline:run full send. Default false so manual-review release flows aren't surprised on upgrade. Default single-sourced at the read site (${VAR:-false}); uncomment to override.
PIPELINE_RELEASE_PR_LABEL="autorelease: pending"   # Label that identifies release-bot PRs to discover. Default matches release-please; override for other bots (e.g. "please-release").
# Pre-think wave planner for /pipeline:run full send. When "true" (default), the orchestrator runs scripts/plan-waves.sh before dispatching classify/plan agents and processes ready issues wave-by-wave (priority tier + explicit blockers + shared-file conflicts). Set to "false" to restore the legacy single-blast parallel dispatch.
#PIPELINE_FULL_SEND_WAVE_PLANNING_ENABLED="true"
# Campaign mode (/pipeline:fullsend --campaign) per-leg caps. BC = max PATH-B/C issues per leg (expensive); overridable per-invocation via --max-bc. Default 2.
#PIPELINE_CAMPAIGN_MAX_BC="2"
# AD = max PATH-A/D issues per campaign leg (cheap/fast); overridable per-invocation via --max-ad. Default 5.
#PIPELINE_CAMPAIGN_MAX_AD="5"
# FOLD = max filed-this-campaign bugs folded into the end-of-campaign fold wave (#838); FIFO, skip non-autonomous. Default 3.
#PIPELINE_CAMPAIGN_MAX_FOLD="3"

# Grouping detection in /pipeline:create-issues. When "true" (default), the skill calls scripts/find-grouping-candidates.sh before printing the proposal list to recommend TRACKER / GROUP / STANDALONE per proposed title. Set to "false" to skip the heuristic entirely (the proposal proceeds as if every recommendation were STANDALONE).
#PIPELINE_GROUPING_DETECTION_ENABLED="true"

# --- Plugin observability logs (issue #318) ---
#
# PIPELINE_LOGS_ENABLED gates plugin writes to .claude/logs/ — specifically
# runs.log, queue-*.log, queue-pending.txt, per-issue tool-use copies
# emitted by cleanup-worktree.sh, the analyze-mode shortlist JSON, and the
# ci-fix attempt logs.
#
# Default is "false" so installing the plugin does not impose logging on a
# consumer project. Trade-off: you lose the crash-diagnosis substrate by
# default — flip to "true" to enable end-to-end observability.
#
# Carve-out: hooks/enforce-path-c-delegation.py and hooks/enforce-ci-wait.py
# still write .claude/logs/enforce-*-errors.log on hook fail-open paths.
# That emergency-diagnosis stream is intentionally ungated.
PIPELINE_LOGS_ENABLED=false

# --- Per-model token pricing (issue #721) ---
#
# Per-1M-token USD rates consumed by `scripts/cost-latency-report.sh
# --tokenomics` to price the dogfood agent-cost logs (same .claude/logs/
# substrate gated by PIPELINE_LOGS_ENABLED above).
#
# Shape: PIPELINE_PRICE_<MODEL>_<BUCKET>, where <BUCKET> is one of INPUT,
# OUTPUT, CACHE_CREATION, CACHE_READ. <MODEL> is the model id normalized by
# upcasing and collapsing each non-alphanumeric run to a single underscore
# (e.g. "claude-opus-4-8" -> "CLAUDE_OPUS_4_8"). Any bucket left unset falls
# back to the per-model list-price defaults baked into the report script
# (Opus, Sonnet, and Haiku each price at their own rates; unknown models fall
# back to Opus as a conservative upper bound — see scripts/cost-latency-report.sh).
#
# The keys below match the script's built-in per-model rates. These are the
# tracked anchor: mirror them BY HAND into the gitignored, host-only live
# pipeline.config (this .example file is never sourced at runtime). The Opus
# block is left live; the Sonnet/Haiku blocks are commented out because they
# already match the baked defaults — they are override anchors, not required
# live settings (uncomment + edit only to override a baked rate).
PIPELINE_PRICE_CLAUDE_OPUS_4_8_INPUT=15
PIPELINE_PRICE_CLAUDE_OPUS_4_8_OUTPUT=75
PIPELINE_PRICE_CLAUDE_OPUS_4_8_CACHE_CREATION=18.75
PIPELINE_PRICE_CLAUDE_OPUS_4_8_CACHE_READ=1.50
# Sonnet 4.6 (matches baked defaults; uncomment to override):
#PIPELINE_PRICE_CLAUDE_SONNET_4_6_INPUT=3
#PIPELINE_PRICE_CLAUDE_SONNET_4_6_OUTPUT=15
#PIPELINE_PRICE_CLAUDE_SONNET_4_6_CACHE_CREATION=3.75
#PIPELINE_PRICE_CLAUDE_SONNET_4_6_CACHE_READ=0.30
# Haiku 4.5 (matches baked defaults; uncomment to override):
#PIPELINE_PRICE_CLAUDE_HAIKU_4_5_INPUT=1
#PIPELINE_PRICE_CLAUDE_HAIKU_4_5_OUTPUT=5
#PIPELINE_PRICE_CLAUDE_HAIKU_4_5_CACHE_CREATION=1.25
#PIPELINE_PRICE_CLAUDE_HAIKU_4_5_CACHE_READ=0.10

# --- Rolling-window usage read-out (issue #725, dogfood-only phase 1) ---
#
# Read-only operator surface over the gated agent-cost capture
# (.claude/logs/agent-costs.jsonl, same PIPELINE_LOGS_ENABLED substrate as the
# #721 pricing block above). Both keys must be set for the read-out to render;
# unset = no read-out. READ-ONLY: it reports window-usage / headroom /
# throttle-ETA so the operator can size the next campaign leg — no hold/queue,
# no auto-pacing (consumer + control loop are out of scope per #725).
# Window length for the rolling-usage sum (~5h subscription cap). Default 5.
# PIPELINE_USAGE_WINDOW_HOURS=5
# Token ceiling the read-out measures headroom against. Unset disables the read-out.
# PIPELINE_USAGE_CAP_TOKENS=

# --- #969 usage gate: pause near plan limit, auto-resume after reset ---
# Real account usage via the OAuth endpoint behind Claude Code's /usage.
# Opt-out kill switch; fail-open on any error (skip + warn, never blocks).
# NOT dogfood-gated (no PIPELINE_LOGS_ENABLED dependency); API-key installs
# with no ~/.claude/.credentials.json degrade to skip reason=no-credentials.
#PIPELINE_USAGE_GATE_ENABLED="true"        # set false to disable the gate
#PIPELINE_USAGE_GATE_THRESHOLD_PCT="85"    # both windows; 5h→pause+resume, 7d→halt
# Per-window enable flags (#1017): mute one window without disabling the gate.
# A muted window never trips its decision but is still reported, and surfaces
# reason=<window>-muted when it would have tripped (never skip — fail-open).
#PIPELINE_USAGE_GATE_SEVEN_DAY_ENABLED="true"  # set false to mute the 7d window (never halt-7d); 5h still gates
#PIPELINE_USAGE_GATE_FIVE_HOUR_ENABLED="true"  # set false to mute the 5h window (never pause-5h); 7d still gates

# --- Stall detection (issue #437) ---
#
# PIPELINE_STALL_POLL_THRESHOLD controls when the queue runner emits
# `EVENT: agent-stalled` for a worker idling at 0% CPU. Default 5 polls
# (~5 minutes at the default POLL_INTERVAL=60s) — well above normal
# model-inference pauses, well below the 50-min wedge observed on
# 2026-05-23 that motivated this knob. Lower (3) raises false-positive
# risk on cold-start; higher (10) approaches half the wedge window.
# Default 5, single-sourced at the read site (${VAR:-5}); uncomment to override.
#PIPELINE_STALL_POLL_THRESHOLD=5

# PIPELINE_STALL_FORWARD_PROGRESS_GATE gates the `agent-stalled` latch on
# forward progress (issue #641). When enabled (default 1), a low-CPU poll only
# advances the stall counter if the worker's tmux pane fingerprint is ALSO
# unchanged since the prior poll — a healthy API-bound agent (executor/evaluator
# blocked on the model) idles near 2% CPU but keeps emitting pane output, so CPU
# alone false-flagged it as stalled. Set to 0 to restore the pre-#641 CPU-only
# behavior (counter advances on idle CPU regardless of pane progress).
# Default 1, single-sourced at the read site (${VAR:-1}); uncomment to override.
#PIPELINE_STALL_FORWARD_PROGRESS_GATE=1

# --- Executor reap grace (issue #636) ---
#
# PIPELINE_EXECUTOR_REAP_GRACE_POLLS controls how many consecutive polls a
# worker must be observed at the `pr-open` label (PR opened — the terminal
# action has been taken) while still alive before the queue runner reaps it,
# freeing the held worktree + concurrency slot. Default 3 polls (~3 minutes at
# the default POLL_INTERVAL=60s). Fail-closed: a transient gh error resets the
# counter, so a worker mid-`gh pr create`/push is never killed. Raise to widen
# the grace window (or set very high to effectively disable the reap).
# Default 3, single-sourced at the read site (${VAR:-3}); uncomment to override.
#PIPELINE_EXECUTOR_REAP_GRACE_POLLS=3

# PIPELINE_REAP_SIGKILL_GRACE_SEC controls how long the queue runner waits
# between SIGTERM and SIGKILL when reaping a finished/wedged worker's process
# GROUP (issue #666). On reap, the runner signals the whole script->timeout->
# claude tree rooted at the tmux pane pid — not just the window — so
# `queue-complete` implies no orphaned child survives. SIGTERM, then this grace,
# then SIGKILL. Default 2 (seconds). Set to 0 to SIGKILL immediately (e.g. in
# tests); raise to give the worker longer to exit cleanly on SIGTERM.
# Default 2, single-sourced at the read site (${VAR:-2}); uncomment to override.
#PIPELINE_REAP_SIGKILL_GRACE_SEC=2

# --- Executor safety-net timeout (issue #656) ---
#
# PIPELINE_EXECUTOR_TIMEOUT_SECONDS bounds how long the spawned executor
# session (tmux mode) may run before `timeout` sends SIGTERM (with a 30s
# grace before SIGKILL). Default 5400 = 90 min. A legitimately heavy PATH C
# can finish green but exceed this budget before the PR step and get
# SIGTERM'd with a complete-but-unpushed branch; raise this to widen the
# window. Only the tmux launch path enforces this timeout.
# Default 5400, single-sourced at the read site (${VAR:-5400}); uncomment to override.
#PIPELINE_EXECUTOR_TIMEOUT_SECONDS=5400

# --- Per-agent resource caps (issue #918) ---
#
# Each spawned agent is launched inside its own transient systemd user scope
# (systemd-run --user --scope) so a runaway fork/memory bomb in one agent is
# OOM/pid-killed inside its cgroup instead of taking down the host. These knobs
# set the scope's ceilings; spawn-claude.sh degrades gracefully to an unbounded
# `timeout … claude …` (plus a WARNING) when systemd-run --user is unavailable
# (containers, Windows/Git-Bash, no user systemd manager) — run /pipeline:doctor
# (agent_resource_caps check) to see the recommended host seatbelt.
#
# PIPELINE_AGENT_MEMORY_MAX is the hard cgroup memory ceiling (MemoryMax); the
# kernel OOM-kills the scope's processes when exceeded. Raise for unusually
# heavy PATH C agents. Default 2G, single-sourced at the read site (${VAR:-2G}).
#PIPELINE_AGENT_MEMORY_MAX=2G
#
# PIPELINE_AGENT_TASKS_MAX is the pid ceiling (TasksMax); a fork bomb hits it
# and fork() fails inside the scope, leaving siblings + host pid space intact.
# Default 512, single-sourced at the read site (${VAR:-512}).
#PIPELINE_AGENT_TASKS_MAX=512
#
# PIPELINE_AGENT_MEMORY_MAX_BROWSER is the MemoryMax ceiling applied INSTEAD of
# PIPELINE_AGENT_MEMORY_MAX for spawned agents that run browser/Playwright work
# under --spawn. Chromium plus a loaded page can exceed the 2G default and get
# OOM-killed inside the cgroup scope (a spurious visual-proof failure), so the
# browser default is higher. Default 4G, single-sourced at the read site
# (${VAR:-4G}); independent of PIPELINE_AGENT_MEMORY_MAX (lowering the base knob
# does NOT clamp browser agents). Only the --spawn transport is affected; the
# default inline path does not go through this scope.
#PIPELINE_AGENT_MEMORY_MAX_BROWSER=4G

# --- Dogfood-only: local-working-tree plugin override (issue #294) ---
#
# When "true" AND the cwd's `git rev-parse --show-toplevel` is the
# rjskene/pipeline repo (origin remote matches) AND that toplevel has
# a `.claude-plugin/plugin.json` sentinel, _resolve-plugin-root.sh
# returns the working tree as CLAUDE_PLUGIN_ROOT instead of walking
# the version-cache at ~/.claude/plugins/cache/claude-pipeline/pipeline/.
#
# Audience: the plugin author's dogfood sessions. Lets staging fixes
# reach dogfood subshells without an RC cut + /plugin install.
#
# Consumer installs MUST leave this unset (default false). Origin and
# sentinel gates make it a no-op for any other repo, but keeping it
# off is the safest default. Default false, single-sourced at the read site
# (${VAR:-false} in _resolve-plugin-root.sh); uncomment to opt in (dogfood only).
#PIPELINE_USE_LOCAL_PLUGIN=false

# --- Label-driven 3-path execution (optional) ---
#
# spawn-claude.sh reads the issue's labels and injects a path-specific
# --append-system-prompt directive before launching the Claude CLI.
#
# Label -> path precedence (first match wins):
#   docs-only   -> PATH A (trivial; no TDD gate)
#   multi-task  -> PATH C (dispatch one implementer subagent per task)
#   (none)      -> PATH B (standard; TDD mandatory - default)
# If both docs-only and multi-task are set, PATH A wins and a stderr warning is logged.
# If `gh issue view` fails (offline/auth), PATH B is used silently.
#
# Three key families, all resolved via bash indirect expansion (${!var}):
#
#   PIPELINE_PATH_<X>_SKILLS_<ALIAS>
#     Space-separated list of fully-qualified skill names (e.g. "superpowers:test-driven-development")
#     to require at the START of the session. Leave empty to skip.
#
#   PIPELINE_PATH_<X>_REVIEWER_<ALIAS>
#     Single subagent name to dispatch as the FINAL tool call (e.g. "superpowers:code-reviewer").
#     Leave empty to skip the reviewer step.
#
#   PIPELINE_PATH_<X>_SKILL_ARGS_<ALIAS>_<NORM>
#     Path (relative to repo root) to a plain-text args file whose content is passed
#     as the `args:` parameter to the matching Skill() invocation.
#
# Placeholders:
#   <X>     in {A, B, C}
#   <ALIAS> in {EXECUTE, EVALUATE_PR, PLAN, EVALUATE_PLAN} (maps to the /skill being launched)
#   <NORM>  = skill name with `superpowers:` stripped, `-` -> `_`, uppercased.
#     e.g. `superpowers:test-driven-development` -> `TEST_DRIVEN_DEVELOPMENT`
#
# Args files live under `scripts/skill-args/<path-letter-lower>-<alias-lower-with-hyphens>-<skill-name-lower-with-hyphens>.txt`.
# Reviewer on EVALUATE_PR is intentionally empty by default - the evaluator is already a review step.
#
# Example (uncomment + adjust for your project):
#
# PIPELINE_PATH_A_SKILLS_EXECUTE="superpowers:verification-before-completion"
# PIPELINE_PATH_A_REVIEWER_EXECUTE="superpowers:code-reviewer"
# PIPELINE_PATH_A_SKILL_ARGS_EXECUTE_VERIFICATION_BEFORE_COMPLETION="scripts/skill-args/a-execute-verification-before-completion.txt"
#
# PIPELINE_PATH_B_SKILLS_EXECUTE="superpowers:test-driven-development superpowers:verification-before-completion"
# PIPELINE_PATH_B_REVIEWER_EXECUTE="superpowers:code-reviewer"
# PIPELINE_PATH_B_SKILL_ARGS_EXECUTE_TEST_DRIVEN_DEVELOPMENT="scripts/skill-args/b-execute-test-driven-development.txt"
# PIPELINE_PATH_B_SKILL_ARGS_EXECUTE_VERIFICATION_BEFORE_COMPLETION="scripts/skill-args/b-execute-verification-before-completion.txt"
#
# PIPELINE_PATH_C_SKILLS_EXECUTE="superpowers:subagent-driven-development"
# PIPELINE_PATH_C_REVIEWER_EXECUTE="superpowers:code-reviewer"
# PIPELINE_PATH_C_SKILL_ARGS_EXECUTE_SUBAGENT_DRIVEN_DEVELOPMENT="scripts/skill-args/c-execute-subagent-driven-development.txt"

# --- per-path execute MODEL routing (#1042: Sonnet is the DEFAULT, opt-OUT) ---
#
# fullsend's execute dispatch (Step 6) pins this model for eligible PATH B / PATH D
# issues; the value is the Agent `model` enum: sonnet | opus | haiku. The lines below
# ship ACTIVE at the Sonnet default (#1042) — a fresh install runs Sonnet on eligible
# PATH B + all PATH D execute. To opt OUT, set `=opus` (the conservative Opus-everywhere
# tier) or comment the line entirely; either restores the Opus inherit at the read site.
# Three carve-outs ALWAYS force Opus regardless of these knobs: the W2 high-uncertainty
# vocab (concurrency|race|lock|deadlock|security|auth|crypto|migration|data-loss), the
# PATH D browser-eval carve-out label (#960), and — the safety-critical one — pr-eval,
# which is NEVER defaulted to Sonnet: the independent evaluator always stays on the
# inherited Opus backstop (the W3 property that makes a cheaper-execute default safe).
# SINGLE SOURCE OF TRUTH (#1056): these knobs are applied at dispatch time in exactly
# ONE place — scripts/resolve-execute-dispatch.sh — which fullsend's Step 6 sources and
# consumes verbatim (campaign inherits by reference). Do NOT re-encode the routing in
# SKILL prose; the resolver folding config + carve-outs into one emitted spec is what
# keeps config and prose from drifting (that drift WAS the #1056 root cause).
PIPELINE_PATH_B_MODEL_EXECUTE=sonnet
PIPELINE_PATH_D_MODEL_EXECUTE=sonnet

# --- #881 Phase 1: PATH B execute eligibility SCOPE (#1042: defaults to `all`) ---
# Controls WHICH PATH B issues the Sonnet execute routing (PIPELINE_PATH_B_MODEL_EXECUTE
# above) applies to. Ships ACTIVE at "all" (#1042): every PATH B issue WITHOUT a
# permanent Opus carve-out (W2 — high-uncertainty vocab concurrency|race|lock|deadlock|
# security|auth|crypto|migration|data-loss, or the browser-eval carve-out label #960)
# routes Sonnet on execute even on a high-blast eligibility verdict. To opt OUT, set
# "low-blast" (or comment the line) to restrict Sonnet to the §4 low-blast lane only:
# issues passing scripts/path-b-execute-eligible.sh's single-module / <=6-file gate.
# The eligibility script is UNCHANGED; under "all" its verdict is advisory (still
# relayed in the run log). W2 carve-outs always inherit Opus. pr-eval ALWAYS stays Opus (W3).
# Applied at dispatch in scripts/resolve-execute-dispatch.sh (the #1056 single source).
PIPELINE_PATH_B_ELIGIBLE_SCOPE="all"

# --- #881 Phase 2: split-role TDD lane (structural test-first compliance) ---
# Ships ACTIVE at "true" (#1057): PATH B execute splits into TWO sequential agents in
# the worktree: (i) an Opus test-author (ALWAYS Opus, regardless of any model knob)
# authors the complete failing suite and commits it once with [split-role-red] in the
# subject; (ii) an implementer (model from PIPELINE_PATH_B_MODEL_EXECUTE; unset ->
# Sonnet per #1042; W2 carve-outs force Opus) greens it test-by-test, additive-only
# (may add tests, never modify/delete the locked suite). The eval-time gate
# scripts/split-role-gate.sh enforces the locked-test git invariant. Default "true"
# (opt OUT with =false) — the safer test-first default that pairs with #1042's
# Sonnet-on-execute (Opus designs the locked suite; the cheap green implements against
# it). pr-eval ALWAYS stays Opus (W3). The dispatch SHAPE (single vs red/green
# split pair) is resolved alongside the model in scripts/resolve-execute-dispatch.sh
# (the #1056 single source); fullsend's Step 6a --verify-dispatch backstop asserts the
# dispatched shape matched the resolver (a collapsed split pair surfaces as a mismatch).
PIPELINE_PATH_B_SPLIT_ROLE=true

# CI-fix loop (issue #52) — autonomous re-dispatch of executor on red CI runs.
PIPELINE_CI_FIX_LOOP_ENABLED="true"   # default true when unset (fullsend 6b reads colon-less ${VAR-true}); set "" to disable. Further gated by PIPELINE_CI_CHECK_ENABLED.
#PIPELINE_CI_FIX_RETRY_BUDGET="2"     # max re-dispatches per PR before applying the human label. Default 2, single-sourced at the read site (${VAR:=2}); uncomment to override.
#PIPELINE_CI_FIX_LOG_LINES="200"      # tail size when injecting CI failure log into executor context. Default 200, single-sourced at the read site (${VAR:=200}); uncomment to override.
# Path to the CI-failure log injected into the CI-fix executor's
# --append-system-prompt by scripts/run-queue.sh. Orchestrator-to-subprocess
# contract — set by run-queue.sh at dispatch time, not by the operator.
# PIPELINE_CI_FIX_CONTEXT=""

# --- analyze-issues stage ---
#
# Age gate for the missing-label signal in scripts/analyze-issues.sh. Issues
# younger than this threshold are silently suppressed so newly-filed issues
# are not flagged before classify-issue has a chance to run. Default 24h.
# PIPELINE_ANALYZE_MIN_AGE_HOURS=24

# --- run-queue ---
#
# When set to "1", scripts/run-queue.sh prints the partitioning + concurrency
# table ("BUCKET: mode=... issues=... max=N") and exits without spawning any
# worker. Used by the queue-partitioning tests; operators rarely set this.
# PIPELINE_QUEUE_DRY_RUN=""

# --- multi-repo helpers ---
#
# Bash-array of consumer-repo helper paths consumed by
# tests/test-skill-helper-env-export.sh to verify cross-repo env propagation.
# Test fixture — operators do not need to set this in a normal install.
# PIPELINE_REPO_CONSUMERS=()

# --- Inline visual-proof loopback server (issue #517) ---
#
# Relative path under the worktree served by inline-mode loopback python http.server.
# PIPELINE_VISUAL_PROOF_TARGET_DIR=""

# Base TCP port for the inline visual-proof loopback python http.server.
# Default 8080, single-sourced at the read site (${VAR:-8080}); uncomment to override.
#PIPELINE_VISUAL_PROOF_PORT_BASE="8080"

# --- Doctor-on-update detector (issue #1038) ---
#
# hooks/doctor-on-update.sh is a thin, READ-ONLY detector wired into
# UserPromptSubmit (primary — fires on your next prompt, no lag after
# /reload-plugins) + SessionStart (backstop). On a plugin version change it
# injects a directive (the model runs the /pipeline:doctor reconcile:
# `--fix config` envvar reconcile + `--fix labels` label seed) plus an operator
# banner, then caches the new version under .claude/logs/. On NO change it is a
# cheap silent no-op (string compare; no network). It mutates nothing but the
# cached version marker — all GitHub/config changes stay in the visible doctor run.
#
# Set "false" to opt out of the detector injection entirely. Default "true",
# single-sourced at the read site (${PIPELINE_DOCTOR_ON_UPDATE_ENABLED:-true}
# in hooks/doctor-on-update.sh); uncomment to override.
#PIPELINE_DOCTOR_ON_UPDATE_ENABLED="true"

set +a  # stop auto-exporting (issue #801 — pairs with the `set -a` above)
