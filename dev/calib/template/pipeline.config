# pipeline.config — calibration sandbox.
#
# This file is copied verbatim into the sandbox repo (rjskene/pipeline-calib)
# when a calibration run is set up. It is deliberately small: the sandbox
# exists to exercise pipeline routing, not to mirror every production knob.
#
# Sourced by shell scripts at runtime; `set -a` exports every assignment so
# values propagate to child bash steps.

set -a

PIPELINE_REPO="rjskene/pipeline-calib"             # the sandbox repo
PIPELINE_BASE_BRANCH="main"                        # sandbox trunk (no staging branch here)
PIPELINE_WORKTREE_PREFIX="wt"                      # worktree dir prefix (wt-<issue>-<slug>)
PIPELINE_INSTALL_CMD=""                            # pure bash project: nothing to install
PIPELINE_SEED_CMD=""                               # no database
PIPELINE_TEST_CMD='bash tests/run.sh'              # single sequential verification pass
PIPELINE_LOGS_ENABLED=true                         # calibration runs need the observability logs
PIPELINE_LOGS_DIR=".claude/logs"                   # where those logs land
PIPELINE_AUTO_MERGE=false                          # a human closes the loop on every calibration PR
PIPELINE_MAX_WAVE_SIZE=5                           # the slate is five issues

set +a
