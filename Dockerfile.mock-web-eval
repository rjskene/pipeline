# syntax=docker/dockerfile:1.6
FROM node:20-bookworm

ARG HOST_UID=1000
ARG HOST_GID=1000

# System deps: gh CLI + dependencies Chromium needs that aren't in playwright --with-deps.
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates gnupg git \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
         | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
         > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# Pinned npm packages — versions resolved deterministically via
# `npm view <pkg> version` at plan time (#230). Bumping these requires
# a deliberate follow-up issue that moves the structural test in lockstep.
RUN npm install -g \
      @anthropic-ai/claude-code@2.1.143 \
      @playwright/mcp@0.0.75 \
      serve@14.2.6

# Install Chromium + its OS-level deps via Playwright. This is the
# heaviest layer in the image; keep it last among the global installs
# so earlier layers stay cacheable.
RUN npx --yes playwright install --with-deps chromium

# Non-root user matching host UID/GID so bind-mount writes aren't root-owned.
# On node:20-bookworm the base image already provisions a `node` user+group at
# UID/GID 1000; rename it to `runner` when the host's UID/GID collides, else
# create fresh. This keeps the contract "user runner at $HOST_UID/$HOST_GID"
# while tolerating the most-common Linux host layout.
RUN set -eux; \
    if getent group  "${HOST_GID}" >/dev/null; then \
      groupmod -n runner "$(getent group  "${HOST_GID}" | cut -d: -f1)"; \
    else \
      groupadd -g "${HOST_GID}" runner; \
    fi; \
    if getent passwd "${HOST_UID}" >/dev/null; then \
      usermod -l runner -d /home/runner -m -g "${HOST_GID}" "$(getent passwd "${HOST_UID}" | cut -d: -f1)"; \
    else \
      useradd -u "${HOST_UID}" -g "${HOST_GID}" -m -s /bin/bash runner; \
    fi

# Read-only bind-mount targets (the compose file does the bind; we just
# make the directories exist with the right owner).
RUN mkdir -p /home/runner/.claude /home/runner/.config/gh \
    && chown -R runner:runner /home/runner

WORKDIR /workspace
USER runner

# Default to the static-host listener so `docker compose up` serves the
# mock app; the smoke test overrides this with `npx playwright --version`.
EXPOSE 3000
CMD ["serve", "-l", "3000", "mock-web"]
