# Pipeline rendered output (.claude/) is TRACKED — worktree provisioning relies on these files.
# Worktree provisioning relies on these files being checked in.
# Only runtime outputs and per-instance config are ignored:
/.claude/logs/
/.claude/worktrees/
/.claude/scratch/
/.claude/settings.local.json
/pipeline.config
# advisory-scanner output (scripts/migration-cleanup-claudemd.sh) — runtime artifact, never tracked
/.claude/migration-cleanup-report-claudemd.txt
/.claude/migration-cleanup-claudemd.patch
hooks/__pycache__/
__pycache__/
*.pyc

/dev/audits/
mock-web-eval/target/.env.mock-web-eval
