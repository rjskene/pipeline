# Allow-list for scripts/check-no-consumer-claude-writes.sh
# One repo-relative path per line. Blank lines and `#` comments ignored.
# Each entry must explain WHY it is exempt. Entries shrink as legacy code is
# migrated to ${CLAUDE_PLUGIN_ROOT}/...

# Runtime path-protection regex — legitimately matches consumer .claude/hooks/
# as a STRING to block writes via the restrict_paths hook itself.
hooks/restrict_paths.py

# One-shot migration tool whose job is to REMOVE consumer
# .claude/{skills,hooks,scripts,agents} — references are inherent.
scripts/migrate-from-subtree.sh

# Runtime worktree provisioning — copies hooks into per-worktree
# .claude/hooks/. Predates plugin-rooted hooks; flagged for follow-up cleanup.
scripts/setup-worktree.sh
scripts/sync-worktrees.sh

# dogfood-only repo audit hook on UserPromptSubmit. Not part of the
# plugin manifest; see issue #134 and the "Self-improvement loop (dogfood-only)"
# section in CLAUDE.md. The .claude/settings.json file is excluded from the
# current lint scan but this entry is recorded defensively so any future
# tightening of the scan keeps this file exempt.
.claude/settings.json

# Doctor's no_residual_subtree check matches the legacy-installer marker path
# .claude/skills/*/.pipeline-managed as a STRING to detect it on consumer
# machines — references are inherent to the check's purpose (issue #144).
scripts/doctor.sh

# preservation_refs helper scans consumer .claude/{scripts,hooks}/ files and
# classifies references found in .claude/settings.json or .claude/skills/*/
# SKILL.md — every .claude/... literal here is a path pattern used by the
# scanner, never a write target (issue #193).
scripts/scan-preservation-refs.sh

# advisory_for_ref_source returns annotation copy for preservation_refs
# buckets; the active-wiring string mentions .claude/settings.json by name so
# the operator knows which file holds the wiring (issue #193).
scripts/_advisory-text.sh

# Housekeeping advisory that scans BOTH .claude-plugin/plugin.json AND the
# consumer's .claude/settings.json for the enforce-base-branch.py PreToolUse
# wiring — every .claude/settings.json mention here is a path pattern the
# scanner reads, never a write target (issue #295).
scripts/check-base-branch-hook-wiring.sh

# review-audits.sh declares a TDD_IMPLEMENTER_MARKER literal pointing at
# .claude/agents/tdd-implementer.md for log-correlation only; not a write
# target. Flagged for follow-up: replace literal with ${CLAUDE_PLUGIN_ROOT}/
# agents/tdd-implementer.md once worktree-resolution rules are clarified.
scripts/review-audits.sh

# container_assets_unwired helper scans consumer .claude/hooks/*.py for
# quoted-literal env-var marker reads — `.claude/hooks/` literals here are
# scan-target path patterns, never write targets (issue #310).
scripts/check-container-assets.sh
